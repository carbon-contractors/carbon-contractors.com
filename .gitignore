# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.claude/settings.local.json

# Devlog and content artefacts — deliberately local.
# Generated post-mortems and devlog script briefs (persona voice notes, retention
# beats, production guidance) are working material, not project documentation. The
# repo is public by design (CC-056), so the published trust artefact is
# docs/Lessons-Learned.md — keep content-production drafts out of it rather than
# relying on nobody staging them by accident.
/devlog/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# hardhat
/artifacts
/cache
/typechain-types
/types/ethers-contracts

.vercel
.env*
.escrow-lifecycle-state.json

# Backlog generated index (managed locally via node scripts/backlog.mjs)
docs/backlog/INDEX.md

