{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "functions": {
    "src/app/api/basedhuman.mcp/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/retention/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/backup-export/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/offer-reminders/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/retention",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/cron/backup-export",
      "schedule": "17 4 * * *"
    },
    {
      "path": "/api/cron/offer-reminders",
      "schedule": "0 * * * *"
    }
  ]
}
