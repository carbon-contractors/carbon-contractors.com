# ─── Blank is not the same as unset (CC-097) ─────────────────────────────────
# A bare `VAR=` line, a blank field in the Vercel dashboard and `docker run -e VAR`
# all put the empty string into the process, not undefined. src/lib/config.ts now
# treats blank as unset so the documented defaults below remain reachable — but a
# malformed value (`RATE_LIMIT_MAX_REQUESTS=abc`, or `=0`) throws at startup rather
# than silently disabling the limiter. To use a default, comment the line out.

# ─── Base Network (REQUIRED — no default) ─────────────────────────────────────
# "testnet" (Base Sepolia) or "mainnet" (Base Mainnet)
# CRITICAL: Must be set explicitly. No default — app will fail without it.
NEXT_PUBLIC_BASE_NETWORK=testnet

# ─── USDC Contract Address (REQUIRED — differs per network) ───────────────────
# Sepolia:  0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Mainnet:  0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ─── Supabase (Phase 1) ──────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Coinbase Developer Platform (Phase 2) ───────────────────────────────────
CDP_API_KEY=your-cdp-api-key

# ─── Escrow Contract (Phase 3) ───────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=0x...your-deployer-private-key

# A DEDICATED endpoint. Every consumer treats these as optional and falls back to the
# public gateway, so setting them to the public URL is the same as leaving them unset —
# which is why this line used to read `BASE_SEPOLIA_RPC_URL=https://sepolia.base.org` and
# was worse than useless: it made "configured" and "on the rate-limited public endpoint"
# indistinguishable at a glance.
#
# The public gateway is rate-limited (CC-048) and load-balances with no read-your-writes
# guarantee, so a read issued straight after a write can hit a node that has not seen it.
# That is what made a successful deploy look like a failure on 2026-08-15, and it is what
# fails the hourly monitors. Base's own Coinbase Developer Platform issues one free; so do
# Alchemy and QuickNode.
# BASE_SEPOLIA_RPC_URL=https://your-dedicated-endpoint
# BASE_MAINNET_RPC_URL=https://your-dedicated-endpoint
NEXT_PUBLIC_ESCROW_CONTRACT=0x...deployed-contract-address

# ─── EAS attestations (CC-036 / ADR-0008) ────────────────────────────────────
# The SchemaRegistry, for verify-eas-schema.mjs. An OP Stack predeploy: the SAME
# address on Base and Base Sepolia, though the implementation behind it differs per
# network. Verified against both chains 2026-08-31 with verify-eas-deployment.mjs.
# Required rather than defaulted, because a wrong or guessed value would PASS against
# nothing at all.
EAS_SCHEMA_REGISTRY_ADDRESS=0x4200000000000000000000000000000000000020

# ─── x402 Protocol (Phase 4) ─────────────────────────────────────────────────
# Public URL of this server (used in fund_url returned by request_human_work)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Wallet that receives x402 payments (defaults to NEXT_PUBLIC_ESCROW_CONTRACT)
# PLATFORM_WALLET_ADDRESS=0x...your-platform-wallet

# ─── GCP Cloud KMS (Phase 7 — production signer via HSM) ─────────────────
# When set, the platform signer uses GCP Cloud KMS instead of DEPLOYER_PRIVATE_KEY.
# The private key never leaves Google's HSM. All values below are non-sensitive metadata.
# GCP_KMS_KEY_PATH=projects/carbon-contractors/locations/us-central1/keyRings/carbon-contractors/cryptoKeys/escrow-signer/cryptoKeyVersions/1
# GCP_PROJECT_NUMBER=529104096274
# GCP_WORKLOAD_IDENTITY_POOL_ID=carbon-contractors-pool
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
# GCP_SERVICE_ACCOUNT_EMAIL=kms-signer-svc@carbon-contractors.iam.gserviceaccount.com

# ─── Reputation Staking (Phase 5) ────────────────────────────────────────────
NEXT_PUBLIC_REPUTATION_STAKE_CONTRACT=0x...deployed-reputation-stake-address

# ─── Production (Phase 6) ────────────────────────────────────────────────────
# Session timeout in ms (default: 1800000 = 30 min)
# SESSION_TIMEOUT_MS=1800000
# Max concurrent MCP sessions (default: 100)
# MAX_SESSIONS=100
# Rate limiting: requests per window (default: 60 per 60s)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=60

# Tasks one authenticated agent may create per hour (default: 30)
# TASK_CREATE_LIMIT_PER_HOUR=30

# ─── Event queries (CC-070) ────────────────────────────────────────────────
# REQUIRED in practice. The block CarbonEscrow was deployed at — every getLogs
# query starts here instead of genesis. Unset, a single query is ~22,700 requests
# instead of ~635, and it fails slowly rather than loudly. Re-derive after every
# redeploy, including the mainnet one (CC-034):
#   node --env-file=.env.local scripts/audit/find-deploy-block.mjs
# Sepolia, as of the CC-082 redeploy:
ESCROW_DEPLOY_BLOCK=45494043
# Max block span per eth_getLogs call. A property of the RPC provider, not the
# protocol — 10,000 on public sepolia.base.org, higher on most paid providers.
# RPC_MAX_BLOCK_RANGE=10000

# ─── Emergency intake kill switch (CC-086 / ADR-0003 D4) ───────────────────
# "true"/"1"/"yes" blocks new task creation. Never pauses claims or settlement.
# NEXT_PUBLIC_INTAKE_PAUSED=false
# NEXT_PUBLIC_INTAKE_PAUSE_NOTICE=Task intake is temporarily paused for system maintenance.

# ─── Notification delivery (CC-095) ────────────────────────────────────────
# All optional. Unconfigured is a visible permanent failure, never a silent skip.
# The email gateway is a URL we POST to rather than a provider credential — picking
# a mail provider is the first third-party data processor in the stack and needs an
# ADR-0002 read first.
# NOTIFICATION_EMAIL_WEBHOOK_URL=https://your-gateway.example/send
# NOTIFICATION_WEBHOOK_SECRET=shared-secret-for-outbound-webhook-signing
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ─── Sanctions screening (CC-099) ──────────────────────────────────────────
# Optional provider layer. The bundled dataset in src/lib/sanctions/data.ts is the
# always-on control; this key only adds a provider on top of it.
# CHAINALYSIS_API_KEY=your-api-key

# ─── Scheduled jobs (CC-087) ───────────────────────────────────────────────
# Shared secret Vercel Cron sends as `Authorization: Bearer <value>`. Set it in the
# Vercel project settings; the value here is only a placeholder.
# /api/cron/retention REFUSES TO RUN without it (503) rather than running
# unauthenticated — it deletes task content and /api/* bypasses the coming-soon gate.
# Generate one with: openssl rand -hex 32
# CRON_SECRET=replace-me-with-32-random-bytes-hex

# ─── Upstash Redis (optional — enables distributed rate limiting) ──────────
# Without these, rate limiting falls back to in-memory (single-instance only).
# Create a free database at console.upstash.com, copy REST URL and token.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here

# ─── Tip Jar / Buy Me a Coffee ─────────────────────────────────────────────
# Wallet address that receives USDC tips from the "Buy Me a Coffee" footer buttons.
NEXT_PUBLIC_TIP_WALLET_ADDRESS=0x...your-wallet-address

# NEXT_PUBLIC_STABLES_AFFILIATE_URL was removed by CC-029 — nothing ever read it,
# the affiliate relationship never existed, and the provider was winding down.
# Delete it from the Vercel environment too if it is still set there. There are
# deliberately no affiliate or referral vars in this project; a commercial
# relationship gets disclosed in /learn, not represented only by a config key.
