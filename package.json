{
  "name": "mcp-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx scripts/seed.ts",
    "verify:kms": "tsx --env-file-if-exists=.env.local scripts/verify-kms-signer.ts",
    "compile": "hardhat compile",
    "gen:abi": "node scripts/gen-abi.mjs",
    "deploy:sepolia": "hardhat run scripts/deploy/escrow.ts --network baseSepolia",
    "deploy:reputation": "hardhat run scripts/deploy/reputation-stake.ts --network baseSepolia",
    "transfer:ownership": "hardhat run scripts/admin/transfer-escrow-ownership.ts --network baseSepolia",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:contracts": "tsc --noEmit -p tsconfig.hardhat.json",
    "test:contracts": "hardhat test"
  },
  "dependencies": {
    "@google-cloud/kms": "^5.4.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@supabase/supabase-js": "^2.99.1",
    "@tanstack/react-query": "^5.90.21",
    "@vercel/oidc": "^3.2.0",
    "bs58": "^6.0.0",
    "google-auth-library": "^10.6.2",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "viem": "^2.47.4",
    "wagmi": "^2.19.5",
    "x402-next": "^1.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.11",
    "@nomicfoundation/hardhat-keystore": "^3.0.12",
    "@nomicfoundation/hardhat-mocha": "^3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-typechain": "^3.1.1",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "chai": "^6.2.2",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "hardhat": "^3.2.0",
    "hardhat-deploy": "^2.0.3",
    "mocha": "^11.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "picomatch": ">=2.3.2",
    "path-to-regexp": ">=8.4.0",
    "defu": ">=6.1.6",
    "lodash": ">=4.17.24",
    "vite": ">=6.4.3 <7",
    "protobufjs": ">=8.6.6",
    "postcss": ">=8.5.18",
    "hono": ">=4.12.34",
    "@hono/node-server": ">=2.0.5",
    "axios": ">=1.18.0",
    "sharp": ">=0.35.0",
    "esbuild": ">=0.28.1",
    "@coinbase/cdp-sdk": "1.46.0",
    "ws": ">=8.21.0",
    "uuid": ">=11.1.1",
    "socket.io-parser": ">=4.2.7",
    "diff": ">=9.0.0",
    "serialize-javascript": ">=7.0.5",
    "nanoid": ">=3.3.17"
  },
  "type": "module"
}
